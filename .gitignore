# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# Never commit an npm config. Development here runs behind an internal registry
# proxy (pkgproxy-uat.coinswitch.co) that CI cannot reach, so a committed
# .npmrc pointing at it fails the Vercel build with E403 on the first tarball.
# For the same reason, check `git diff package-lock.json` before committing
# after an `npm install` — the proxy rewrites every `resolved` URL to itself.
.npmrc
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keep a committed template for env vars (secrets stay in .env.local)
!.env.example

# local-only asset tooling: never deployed (assets/brand/ is outside public/,
# and build-assets.py isn't invoked by `next build`), so kept local rather
# than pushed. Untracked, not deleted — see README.md for what it does.
/assets/brand/
/scripts/build-assets.py
